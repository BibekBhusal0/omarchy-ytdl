#!/usr/bin/env bash
# Output at most <max-bytes> of the Wayland clipboard; exit 1 when larger.
# Usage: read-clipboard <max-bytes> [primary]
set -euo pipefail

max="${1:?max bytes required}"
[[ "$max" =~ ^[0-9]+$ ]] || exit 1
(( max > 0 && max <= 1048576 )) || exit 1
mode="${2:-clipboard}"
[[ "$mode" == "clipboard" || "$mode" == "primary" ]] || exit 1
exec /usr/bin/python3 - "$max" "$mode" <<'EOF'
import select
import subprocess
import sys
import time

max_bytes = int(sys.argv[1])
# Deadline: a trickling owner could hold the pipe open forever.
deadline = time.monotonic() + 10
cmd = ["/usr/bin/wl-paste", "--no-newline"]
if sys.argv[2] == "primary":
    cmd.append("--primary")
proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
data = b""
try:
    while len(data) <= max_bytes:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            sys.exit(1)
        ready, _, _ = select.select([proc.stdout], [], [], remaining)
        if not ready:
            sys.exit(1)
        chunk = proc.stdout.read(min(65536, max_bytes + 1 - len(data)))
        if not chunk:
            break
        data += chunk
finally:
    proc.kill()
    proc.wait()
if len(data) > max_bytes:
    sys.exit(1)
sys.stdout.buffer.write(data)
EOF
