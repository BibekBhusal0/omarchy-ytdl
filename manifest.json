{
  "schemaVersion": 1,
  "id": "bibek.ytdl",
  "name": "Youtube Video Downloader",
  "version": "1.0.9",
  "author": "Bibek Bhusal",
  "description": "Download videos and playlists from YouTube and other sites via yt-dlp with up to three parallel downloads, a queue, and a persistent history.",
  "homepage": "https://github.com/BibekBhusal0/omarchy-ytdl",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Youtube Video Downloader",
    "description": "Video and playlist downloader with parallel downloads, a queue, and a persistent history.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "downloadLocation": "~/Downloads/yt-dlp",
      "defaultQuality": "1080p",
      "defaultDownloadType": "video",
      "cookiesBrowser": "none",
      "extraArgs": "",
      "enableHistory": true,
      "downloadTranscripts": false,
      "transcriptLanguages": "en",
      "playlistInSeparateFolder": true
    }
  }
}
